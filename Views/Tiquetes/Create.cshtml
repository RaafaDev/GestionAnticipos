@model GestionAnticiposApp.ViewModels.TiquetesVM

<h2>Registrar Tiquete</h2>

<form asp-action="Create" enctype="multipart/form-data">
    <div class="form-group">
        <label>Anticipo</label>
        <select asp-for="ProcesoVinculadoId" class="form-control" asp-items="@(new SelectList(ViewBag.Anticipos, "Id", "Codigo"))"></select>
    </div>

    <div class="form-group">
        <label asp-for="Concepto"></label>
        <input asp-for="Concepto" class="form-control" />
        <span asp-validation-for="Concepto" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Valor"></label>
        <input asp-for="Valor" class="form-control" />
        <span asp-validation-for="Valor" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Fecha"></label>
        <input asp-for="Fecha" type="date" class="form-control" />
        <span asp-validation-for="Fecha" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Documentos</label>
        <input asp-for="Archivos" type="file" multiple class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
</form>
