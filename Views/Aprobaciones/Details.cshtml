@model GestionAnticiposApp.Models.ViewModels.AnticipoVM

@{
    ViewData["Title"] = "Detalles del Anticipo";
}

<h2>Detalles del Anticipo</h2>
<hr />

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9">@Model.Codigo</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">@Model.Estado</dd>

            <dt class="col-sm-3">Fecha de Solicitud</dt>
            <dd class="col-sm-9">@Model.FechaSolicitud.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Valor</dt>
            <dd class="col-sm-9">@Model.Valor.ToString("C")</dd>

            <dt class="col-sm-3">Funcionario</dt>
            <dd class="col-sm-9">@Model.Funcionario</dd>

            <dt class="col-sm-3">Autorizador</dt>
            <dd class="col-sm-9">@Model.Autorizador</dd>

            <dt class="col-sm-3">Comentarios</dt>
            <dd class="col-sm-9">@Model.Comentarios</dd>

            <dt class="col-sm-3">Puede Aprobar</dt>
            <dd class="col-sm-9">
                @if (Model.PuedeAprobar)
                {
                    <span class="badge bg-success">Sí</span>
                }
                else
                {
                    <span class="badge bg-secondary">No</span>
                }
            </dd>
        </dl>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" asp-route-contratoId="@ViewBag.ContratoId" class="btn btn-warning">Editar</a>
    <a asp-action="Delete" asp-route-id="@Model.Id" asp-route-contratoId="@ViewBag.ContratoId" class="btn btn-danger">Eliminar</a>
    <a asp-action="Details" asp-controller="Contratos" asp-route-id="@ViewBag.ContratoId" class="btn btn-secondary">Volver al Contrato</a>
</div>
