@model GestionAnticiposApp.Controllers.EditRolesViewModel

@{
    ViewData["Title"] = "Editar Roles";
}

<h2>Editar Roles para: @Model.Email</h2>

<form asp-action="EditRoles" method="post">
    <input type="hidden" asp-for="UserId" />

    <div class="form-group">
        @for (int i = 0; i < Model.Roles.Count; i++)
        {
            <div class="form-check">
                <input type="hidden" asp-for="Roles[@i].RoleName" />
                <input asp-for="Roles[@i].Selected" class="form-check-input" />
                <label class="form-check-label">@Model.Roles[i].RoleName</label>
            </div>
        }
    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>