@model GestionAnticiposApp.Models.PaginatedList<GestionAnticiposApp.Models.Log>

@{
    ViewData["Title"] = "Historial de Cambios";
}

<h1>Historial de Cambios</h1>

<table class="table">
    <thead>
        <tr>
            <th>Usuario</th>
            <th>Codigo</th>
            <th>Campo</th>
            <th>Tipo</th>
            <th>Valor Antes</th>
            <th>Valor Después</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.Usuario</td>
                <td>@(log.ProcesoVinculado?.Codigo ?? "-")</td>
                <td>@log.Campo</td>
                <td>@(log.ProcesoVinculado?.Tipo != null ? log.ProcesoVinculado.Tipo.ToString() : "Anticipo")</td>
                <td>@log.ValorAntes</td>
                <td>@log.ValorDespues</td>
                <td>@log.Fecha.ToString("g")</td>
            </tr>
        }
    </tbody>
</table>
<nav aria-label="Paginación">
    <ul class="pagination">
        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index"
               asp-route-pageIndex="@(Model.PageIndex - 1)"
               asp-route-searchCodigo="@ViewData["searchCodigo"]">Anterior</a>
        </li>
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.PageIndex ? "active" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-pageIndex="@i"
                   asp-route-searchCodigo="@ViewData["searchCodigo"]">@i</a>
            </li>
        }
        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
            <a class="page-link" asp-action="Index"
               asp-route-pageIndex="@(Model.PageIndex + 1)"
               asp-route-searchCodigo="@ViewData["searchCodigo"]">Siguiente</a>
        </li>
    </ul>
</nav>

