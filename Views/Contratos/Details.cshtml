@model GestionAnticiposApp.Models.Contratos
@{
    ViewData["Title"] = "Detalles del Contrato";
}

<h2>@ViewData["Title"]</h2>
<hr />

<div class="mb-3">
    <h4>Información del contrato</h4>
    <dl class="row">
        <dt class="col-sm-3">Código</dt>
        <dd class="col-sm-9">@Model.Codigo</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@Model.Estado</dd>

        <dt class="col-sm-3">Fecha Inicio</dt>
        <dd class="col-sm-9">@Model.FechaInicio.ToShortDateString()</dd>

        <dt class="col-sm-3">Fecha Fin</dt>
        <dd class="col-sm-9">@Model.FechaFin.ToShortDateString()</dd>
    </dl>
</div>

<hr />

<div class="mb-3">
    <h4>Procesos vinculados</h4>

    <div class="d-flex gap-2 mb-3">
        <a asp-controller="Anticipos" asp-action="Create" asp-route-contratoId="@Model.Id" class="btn btn-primary">
            Agregar Anticipo
        </a>
        <a asp-controller="Tiquetes" asp-action="Create" asp-route-contratoId="@Model.Id" class="btn btn-success">
            Agregar Tiquete
        </a>
    </div>

    @if (Model.ProcesosVinculados != null && Model.ProcesosVinculados.Any())
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Tipo</th>
                    <th>Estado</th>
                    <th>Funcionario</th>
                    <th>Fecha Solicitud</th>
                    <th>Valor</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.ProcesosVinculados.Where(p => p.Tipo == 0 || p.Tipo == 0))
                {
                    <tr>
                        <td>@p.Codigo</td>
                        <td>@p.Tipo</td>
                        <td>@p.Estado</td>
						<td>@p.Funcionario</td>
                        <td>@p.FechaSolicitud.ToShortDateString()</td>
                        <td>@p.Valor.ToString("C")</td>
                        <td>
                            @if (p.Tipo == 0)
                            {
                                <a asp-controller="Anticipos" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-controller="Anticipos" asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            }
                            else if (p.Tipo == 0)
                            {
                                <a asp-controller="Tiquetes" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>
                                <a asp-controller="Tiquetes" asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Eliminar</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No hay anticipos ni tiquetes vinculados a este contrato.</p>
    }
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>