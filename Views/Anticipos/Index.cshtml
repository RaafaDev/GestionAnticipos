@model IEnumerable<GestionAnticiposApp.Models.ProcesosVinculados>

@{
    ViewData["Title"] = "Inde";
}

<h1>Anticipos</h1>

<div class="col-md-12" style="padding-left: 0px !important">
    <form asp-controller="Anticipos" asp-action="Index" method="get" class="form-inline">
        <div class="form-group mb-2">
            <datalist id="funcionarioByUser"></datalist>
            <input type="hidden" id="hiddenFuncionarioId" value="defaultId">
            <input list="funcionarioByUser" autocomplete="off"
                   name="Funcionario" id="funcionarioByUserName"
                   value="@ViewData["Funcionario"]"
                   placeholder="Nombre funcionario"
                   class="form-control form-control-sm regular-text"
                   style="width: 150px;" />
        </div>

        <div class="form-group mx-sm-2 mb-2">
            <label class="sr-only regular-text">Estado</label>
            <input name="Estado"
                   value="@ViewData["Estado"]"
                   placeholder="Aprovado"
                   class="form-control form-control-sm regular-text"
                   style="width: 150px;" />
        </div>

        <div class="form-group mx-sm-2 mb-2">
            <label class="sr-only regular-text">Código del contrato</label>
            <input name="Codigo"
                   value="@ViewData["CodigoContra"]"
                   placeholder="AUD000321"
                   class="form-control form-control-sm regular-text"
                   style="width: 150px;" />
        </div>

       

        <div class="mb-1 mx-sm-2">
            <button type="submit" class="btn btn-crowe mb-1 regular-text btn-sm " style="width:130px;height:34px;">Buscar</button>
            <a class="btn btn-secondary mb-1 regular-text btn-sm"
               href="@Url.Action("Anticipos")" style="width:130px;height:34px">Limpiar filtros</a>
        </div>








    </form>

</div>
<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Codigo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Estado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Funcionario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FechaSolicitud)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Autorizador)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
         
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Where(p => p.Tipo == 0 || p.Tipo == 0))
        {
            <tr>
                <td>@p.Codigo</td>
                <td>@p.Tipo</td>
                <td>@p.Estado</td>
                <td>@p.FechaSolicitud.ToShortDateString()</td>
                <td>@p.Valor.ToString("C")</td>
                <td>
                    @if (p.Tipo == 0)
                    {
                        <a asp-controller="Anticipos" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-controller="Anticipos" asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                    else if (p.Tipo == 0)
                    {
                        <a asp-controller="Tiquetes" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">Editar</a>
                        <a asp-controller="Tiquetes" asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">Eliminar</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
