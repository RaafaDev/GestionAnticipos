@model GestionAnticiposApp.Models.ViewModels.AnticipoVM
@{
    ViewData["Title"] = "Editar Anticipo";
}

<style>
    :root {
        --azul-oscuro: #0C1E5B;
        --azul-medio: #1a3bb3;
        --azul-claro: #f0f4ff;
        --amarillo: #FFD700;
        --amarillo-oscuro: #e6c300;
        --blanco: #ffffff;
        --gris-claro: #f8f9fa;
        --gris-medio: #e9ecef;
        --verde: #28a745;
        --rojo: #dc3545;
        --texto-oscuro: #333;
        --sombra: rgba(12, 30, 91, 0.15);
        --borde: #e1e5ee;
    }

    /* body {
        background: linear-gradient(135deg, var(--azul-claro) 0%, #e6eaff 100%);
        min-height: 100vh;
        padding: 20px;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        display: flex;
        justify-content: center;
        align-items: flex-start;
    } */

    .form-container {
        background: var(--blanco);
        border-radius: 16px;
        box-shadow: 0 10px 40px rgba(12, 30, 91, 0.2);
        padding: 40px;
        margin: 30px auto;
        max-width: 850px;
        width: 100%;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.5);
    }

        .form-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, var(--amarillo), var(--azul-oscuro));
            border-radius: 8px 8px 0 0;
        }

    .page-title {
        color: var(--azul-oscuro);
        font-weight: 700;
        margin-bottom: 15px;
        padding-bottom: 15px;
        border-bottom: 2px solid var(--amarillo);
        text-align: center;
        font-size: 2.2rem;
        text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
        position: relative;
    }

    .edit-badge {
        display: inline-block;
        background: linear-gradient(135deg, var(--amarillo) 0%, var(--amarillo-oscuro) 100%);
        color: var(--azul-oscuro);
        padding: 8px 18px;
        border-radius: 30px;
        font-size: 1rem;
        font-weight: 700;
        margin-bottom: 30px;
        box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
        text-align: center;
        width: 100%;
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
    }

    .form-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .form-label {
        color: var(--azul-oscuro);
        font-weight: 600;
        margin-bottom: 10px;
        display: block;
        font-size: 1.05rem;
        position: relative;
        padding-left: 8px;
        border-left: 3px solid var(--amarillo);
    }

    .form-control {
        border: 2px solid var(--borde);
        border-radius: 10px;
        padding: 14px 18px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background-color: var(--gris-claro);
        width: 100%;
        box-sizing: border-box;
    }

        .form-control:focus {
            border-color: var(--amarillo);
            box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.2);
            outline: none;
            background-color: var(--blanco);
            transform: translateY(-2px);
        }

    .text-danger {
        font-size: 0.9rem;
        margin-top: 8px;
        font-weight: 500;
        color: var(--rojo) !important;
        display: block;
        padding-left: 5px;
    }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--azul-oscuro) 0%, var(--azul-medio) 100%);
        color: var(--blanco);
        border: none;
        border-radius: 10px;
        padding: 16px 35px;
        font-weight: 700;
        transition: all 0.3s ease;
        min-width: 180px;
        box-shadow: 0 5px 15px rgba(12, 30, 91, 0.3);
        font-size: 1.1rem;
        position: relative;
        overflow: hidden;
    }

        .btn-primary-custom::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: all 0.5s ease;
        }

        .btn-primary-custom:hover::before {
            left: 100%;
        }

        .btn-primary-custom:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(12, 30, 91, 0.4);
        }

    .btn-secondary-custom {
        background: linear-gradient(135deg, var(--gris-claro) 0%, var(--gris-medio) 100%);
        color: var(--azul-oscuro);
        border: 2px solid var(--borde);
        border-radius: 10px;
        padding: 16px 35px;
        font-weight: 700;
        transition: all 0.3s ease;
        min-width: 180px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    }

        .btn-secondary-custom:hover {
            background: linear-gradient(135deg, var(--gris-medio) 0%, #dde1e6 100%);
            color: var(--azul-oscuro);
            transform: translateY(-3px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.12);
            text-decoration: none;
            border-color: var(--amarillo);
        }

    .button-group {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 40px;
        padding-top: 30px;
        border-top: 1px solid var(--gris-medio);
        flex-wrap: wrap;
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        margin-bottom: 25px;
    }

    .form-group {
        margin-bottom: 2rem;
        position: relative;
    }

    textarea.form-control {
        min-height: 120px;
        resize: vertical;
        line-height: 1.6;
        padding: 16px;
    }

    .input-icon {
        position: relative;
    }

        .input-icon i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--azul-oscuro);
            z-index: 1;
        }

        .input-icon .form-control {
            padding-left: 45px;
        }

    .role-badge {
        display: inline-block;
        background: linear-gradient(135deg, var(--verde) 0%, #1e7e34 100%);
        color: white;
        padding: 6px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        margin-top: 10px;
        box-shadow: 0 3px 8px rgba(40, 167, 69, 0.3);
    }

    .form-section {
        background: var(--azul-claro);
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 25px;
        border-left: 5px solid var(--amarillo);
    }

    .form-section-title {
        color: var(--azul-oscuro);
        font-weight: 700;
        margin-bottom: 15px;
        font-size: 1.2rem;
    }

    @@media (max-width: 900px) {
        .form-container {
            padding: 30px 20px;
            margin: 20px 10px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 15px;
        }

        .button-group {
            flex-direction: column;
            align-items: center;
        }

        .btn-primary-custom, .btn-secondary-custom {
            width: 100%;
            max-width: 300px;
        }

        .page-title {
            font-size: 1.8rem;
        }
    }

    /* Animaciones */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-container {
        animation: fadeIn 0.6s ease-out;
    }

    .form-group {
        animation: fadeIn 0.8s ease-out;
    }

    .button-group {
        animation: fadeIn 1s ease-out;
    }
</style>

<div class="form-container">
    <div class="form-header">
        <h2 class="page-title">@ViewData["Title"]</h2>
        <div class="edit-badge">Editando anticipo: @Model.Codigo</div>
    </div>

    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" name="contratoId" value="@ViewBag.ContratoId" />

        <div class="form-section">
            <h3 class="form-section-title">Información Básica</h3>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Codigo" class="form-label"></label>
                    <div class="input-icon">
                        <i class="fas fa-hashtag"></i>
                        <input asp-for="Codigo" class="form-control" placeholder="Ingrese el código del anticipo" />
                    </div>
                    <span asp-validation-for="Codigo" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h3 class="form-section-title">Detalles del Anticipo</h3>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="FechaSolicitud" class="form-label"></label>
                    <div class="input-icon">
                        <i class="fas fa-calendar-alt"></i>
                        <input asp-for="FechaSolicitud" class="form-control" type="date" />
                    </div>
                    <span asp-validation-for="FechaSolicitud" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Valor" class="form-label"></label>
                    <div class="input-icon">
                        <i class="fas fa-dollar-sign"></i>
                        <input asp-for="Valor" class="form-control" type="number" step="0.01" placeholder="0.00" />
                    </div>
                    <span asp-validation-for="Valor" class="text-danger"></span>
                </div>
            </div>
        </div>

        @using Microsoft.AspNetCore.Identity
        @if (User.IsInRole("Aprobador"))
        {
            <div class="form-section">
                <h3 class="form-section-title">Estado del Anticipo <span class="role-badge">Usuario Aprobador</span></h3>
                <div class="form-group">
                    <label asp-for="Estado" class="form-label"></label>
                    <div class="input-icon">
                        <i class="fas fa-check-circle"></i>
                        <select asp-for="Estado" class="form-control">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Aprobado">Aprobado</option>
                            <option value="Rechazado">Rechazado</option>
                        </select>
                    </div>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="Estado" />
        }

        <div class="form-section">
            <h3 class="form-section-title">Comentarios Adicionales</h3>
            <div class="form-group">
                <label asp-for="Comentarios" class="form-label"></label>
                <div class="input-icon">
                    <i class="fas fa-comment"></i>
                    <textarea asp-for="Comentarios" class="form-control" placeholder="Ingrese comentarios adicionales sobre el anticipo"></textarea>
                </div>
                <span asp-validation-for="Comentarios" class="text-danger"></span>
            </div>
        </div>

        <div class="button-group">
            <button type="submit" class="btn-primary-custom">
                <i class="fas fa-save"></i> Guardar cambios
            </button>
            <a asp-action="Details" asp-controller="Contratos" asp-route-id="@ViewBag.ContratoId" class="btn-secondary-custom">
                <i class="fas fa-times"></i> Cancelar
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- Font Awesome para iconos -->
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

    <script>
        // Cerrar menú lateral si está abierto al cargar esta página
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            if (sidebar && sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
            }

            // Animación para los elementos del formulario
            const formGroups = document.querySelectorAll('.form-group');
            formGroups.forEach((group, index) => {
                group.style.animationDelay = `${index * 0.1}s`;
            });
        });
    </script>
}