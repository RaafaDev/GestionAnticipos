@model GestionAnticiposApp.Models.ViewModels.AnticipoVM
@{
    ViewData["Title"] = "Eliminar Anticipo";
}

<style>
    :root {
        --azul-oscuro: #0C1E5B;
        --azul-medio: #1a3bb3;
        --azul-claro: #f0f4ff;
        --amarillo: #FFD700;
        --amarillo-oscuro: #e6c300;
        --blanco: #ffffff;
        --gris-claro: #f8f9fa;
        --gris-medio: #e9ecef;
        --verde: #28a745;
        --rojo: #dc3545;
        --rojo-oscuro: #b02a37;
        --sombra: rgba(12, 30, 91, 0.15);
    }

    body {
        background: linear-gradient(135deg, var(--azul-claro) 0%, #d6e0ff 100%);
        padding: 40px 20px;
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .main-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: calc(100vh - 80px);
    }

    .delete-container {
        background: var(--blanco);
        border-radius: 20px;
        box-shadow: 0 15px 50px rgba(12, 30, 91, 0.25);
        padding: 40px;
        width: 100%;
        max-width: 800px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.8);
        text-align: center;
    }

        .delete-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 8px;
            background: linear-gradient(90deg, var(--rojo), var(--azul-oscuro), var(--rojo));
            border-radius: 10px 10px 0 0;
        }

    .delete-header {
        text-align: center;
        margin-bottom: 35px;
        position: relative;
    }

    .delete-icon {
        background: linear-gradient(135deg, var(--rojo) 0%, var(--rojo-oscuro) 100%);
        width: 80px;
        height: 80px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        box-shadow: 0 8px 20px rgba(220, 53, 69, 0.3);
        border: 4px solid var(--blanco);
    }

        .delete-icon i {
            font-size: 2.5rem;
            color: var(--blanco);
        }

    .page-title {
        color: var(--rojo);
        font-weight: 800;
        margin-bottom: 10px;
        font-size: 2.5rem;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
        letter-spacing: 0.5px;
    }

    .alert-warning-custom {
        background: linear-gradient(135deg, #fff3cd 0%, #ffecb5 100%);
        border: 2px solid var(--amarillo);
        border-radius: 16px;
        padding: 25px;
        margin-bottom: 35px;
        box-shadow: 0 6px 20px rgba(255, 193, 7, 0.2);
        text-align: center;
    }

        .alert-warning-custom strong {
            color: var(--azul-oscuro);
            font-size: 1.3rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

            .alert-warning-custom strong i {
                color: var(--rojo);
                font-size: 1.8rem;
            }

    .details-container {
        background: linear-gradient(135deg, var(--gris-claro) 0%, var(--blanco) 100%);
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 35px;
        border: 1px solid rgba(255, 255, 255, 0.8);
        box-shadow: inset 0 2px 10px rgba(12, 30, 91, 0.05);
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 25px;
        text-align: left;
    }

    .detail-item {
        padding: 20px;
        background: var(--blanco);
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(12, 30, 91, 0.1);
        border-left: 4px solid var(--azul-oscuro);
        transition: transform 0.3s ease;
    }

        .detail-item:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(12, 30, 91, 0.15);
        }

    .detail-label {
        color: var(--azul-oscuro);
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .detail-label i {
            color: var(--amarillo);
            font-size: 1.3rem;
        }

    .detail-value {
        color: var(--azul-oscuro);
        font-size: 1.2rem;
        font-weight: 600;
        padding: 12px;
        background: rgba(12, 30, 91, 0.05);
        border-radius: 8px;
        border-left: 3px solid var(--amarillo);
    }

    .valor-highlight {
        color: var(--rojo);
        font-weight: 700;
        font-size: 1.3rem;
    }

    .button-group {
        display: flex;
        gap: 20px;
        justify-content: center;
        margin-top: 30px;
        padding-top: 30px;
        border-top: 1px solid rgba(12, 30, 91, 0.1);
    }

    .btn-danger-custom {
        background: linear-gradient(135deg, var(--rojo) 0%, var(--rojo-oscuro) 100%);
        color: var(--blanco);
        border: none;
        border-radius: 12px;
        padding: 16px 35px;
        font-weight: 700;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        min-width: 150px;
        box-shadow: 0 8px 25px rgba(220, 53, 69, 0.3);
        position: relative;
        overflow: hidden;
    }

        .btn-danger-custom::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-danger-custom:hover {
            transform: translateY(-4px) scale(1.02);
            box-shadow: 0 12px 35px rgba(220, 53, 69, 0.4);
        }

            .btn-danger-custom:hover::before {
                left: 100%;
            }

    .btn-secondary-custom {
        background: linear-gradient(135deg, var(--gris-claro) 0%, var(--gris-medio) 100%);
        color: var(--azul-oscuro);
        border: 2px solid var(--azul-oscuro);
        border-radius: 12px;
        padding: 16px 35px;
        font-weight: 700;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        min-width: 150px;
        box-shadow: 0 6px 20px rgba(108, 117, 125, 0.15);
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .btn-secondary-custom:hover {
            background: linear-gradient(135deg, var(--azul-oscuro) 0%, var(--azul-medio) 100%);
            color: var(--blanco);
            transform: translateY(-4px);
            box-shadow: 0 10px 30px rgba(12, 30, 91, 0.25);
            text-decoration: none;
        }

    /* Animaciones CORREGIDAS - usando @@keyframes en lugar de  */
     fadeIn {
        from

     {
        opacity: 0;
        transform: translateY(20px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }

    pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }

    .delete-container {
        animation: fadeIn 0.6s ease-out;
    }

    .delete-icon {
        animation: pulse 2s infinite;
    }

    .detail-item {
        animation: fadeIn 0.8s ease-out;
    }

    @@media (max-width: 992px) {
        body {
            padding: 20px 15px;
        }

        .delete-container {
            padding: 30px 25px;
        }

        .details-grid {
            grid-template-columns: 1fr;
            gap: 20px;
        }

        .button-group {
            flex-direction: column;
            gap: 15px;
        }

        .btn-danger-custom, .btn-secondary-custom {
            width: 100%;
        }

        .page-title {
            font-size: 2rem;
        }
    }

    @@media (max-width: 576px) {
        .delete-container {
            padding: 25px 20px;
            border-radius: 15px;
        }

        .details-container {
            padding: 20px 15px;
        }

        .delete-icon {
            width: 70px;
            height: 70px;
        }

        .page-title {
            font-size: 1.8rem;
        }

        .alert-warning-custom {
            padding: 20px 15px;
        }

            .alert-warning-custom strong {
                font-size: 1.1rem;
                flex-direction: column;
                gap: 8px;
            }
    }
</style>

<div class="main-container">
    <div class="delete-container">
        <div class="delete-header">
            <div class="delete-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <h2 class="page-title">@ViewData["Title"]</h2>
        </div>

        <div class="alert-warning-custom">
            <strong>
                <i class="bi bi-exclamation-octagon-fill"></i>
                ¿Estás seguro que deseas eliminar este anticipo?
            </strong>
            <p style="color: var(--azul-oscuro); margin-top: 15px; font-weight: 500;">
                Esta acción no se puede deshacer. El anticipo será eliminado permanentemente del sistema.
            </p>
        </div>

        <div class="details-container">
            <h3 style="color: var(--azul-oscuro); margin-bottom: 25px; text-align: center; font-weight: 700;">
                <i class="bi bi-info-circle"></i>
                Información del Anticipo a Eliminar
            </h3>

            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-tag"></i>
                        Código
                    </div>
                    <div class="detail-value">@Model.Codigo</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-check2-circle"></i>
                        Estado
                    </div>
                    <div class="detail-value">@Model.Estado</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-calendar-event"></i>
                        Fecha Solicitud
                    </div>
                    <div class="detail-value">@Model.FechaSolicitud.ToShortDateString()</div>
                </div>

                <div class="detail-item">
                    <div class="detail-label">
                        <i class="bi bi-cash-coin"></i>
                        Valor
                    </div>
                    <div class="detail-value valor-highlight">@Model.Valor.ToString("C")</div>
                </div>

                <div class="detail-item" style="grid-column: 1 / -1;">
                    <div class="detail-label">
                        <i class="bi bi-chat-dots"></i>
                        Comentarios
                    </div>
                    <div class="detail-value" style="min-height: 60px; background: rgba(12, 30, 91, 0.03);">
                        @(string.IsNullOrEmpty(Model.Comentarios) ? "Sin comentarios" : Model.Comentarios)
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" name="contratoId" value="@ViewBag.ContratoId" />

            <div class="button-group">
                <button type="submit" class="btn-danger-custom">
                    <i class="bi bi-trash3-fill"></i> Confirmar Eliminación
                </button>
                <a asp-action="Details" asp-controller="Contratos" asp-route-id="@ViewBag.ContratoId" class="btn-secondary-custom">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Cerrar menú lateral si está abierto al cargar esta página
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            if (sidebar && sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
            }
        });
    </script>
}