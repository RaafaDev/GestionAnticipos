@model GestionAnticiposApp.Models.ViewModels.AnticipoVM

@{
    ViewData["Title"] = "Detalles del Anticipo";
}

<div class="anticipos-container">
    <h1 class="page-title">Detalles del Anticipo</h1>

    <div class="table-container">
        <table class="custom-table">
            <tbody>
                <tr>
                    <th>Código</th>
                    <td>@Model.Codigo</td>
                </tr>
                <tr>
                    <th>Estado</th>
                    <td>@Model.Estado</td>
                </tr>
                <tr>
                    <th>Fecha Solicitud</th>
                    <td>@Model.FechaSolicitud.ToString("dd/MM/yyyy")</td>
                </tr>
                <tr>
                    <th>Valor</th>
                    <td class="valor-cell">@Model.Valor.ToString("C")</td>
                </tr>
                <tr>
                    <th>Comentarios</th>
                    <td>@Model.Comentarios</td>
                </tr>
                <tr>

                    <th>Funcionario</th>
                    <td>@Model.Funcionario</td>
                </tr>
            </tbody>
        </table>
    </div>
    <div class="documentos-container">
        <h2>Documentos Adjuntos</h2>
        @if (Model.Documentos != null && Model.Documentos.Any())
        {
            <ul class="documentos-list">
                @foreach (var doc in Model.Documentos)
                {
                    <li>
                        <a href="@doc.Archivo" target="_blank" download>
                         
                            @doc.Archivo
                        </a>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No hay documentos adjuntos.</p>
        }
    </div>

    <a asp-action="Details" asp-controller="Contratos" asp-route-id="@ViewBag.ContratoId" class="btn btn-secondary">
        Volver al Contrato
    </a>

</div>
