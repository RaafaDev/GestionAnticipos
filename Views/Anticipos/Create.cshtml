@model GestionAnticiposApp.Models.ViewModels.AnticipoVM
@{
    ViewData["Title"] = "Agregar Anticipo";
}

<h2>@ViewData["Title"]</h2>
<hr />

<form asp-action="Create" method="post" enctype="multipart/form-data">
    <input type="hidden" name="contratoId" value="@ViewBag.ContratoId" />

    <div class="mb-3">
        <label asp-for="Codigo" class="form-label"></label>
        <input asp-for="Codigo" class="form-control" />
        <span asp-validation-for="Codigo" class="text-danger"></span>
    </div>

    <div class="mb-3" style="display:none;">
        <label asp-for="Estado" class="form-label"></label>
        <input asp-for="Estado" class="form-control" value="Pendiente" />
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>

        <div class="form-row">
            <div class="form-group">
                <label asp-for="FechaSolicitud" class="form-label"></label>
                <input asp-for="FechaSolicitud" class="form-control" type="date" />
                <span asp-validation-for="FechaSolicitud" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Valor" class="form-label"></label>
                <input asp-for="Valor" class="form-control" type="number" step="0.01" placeholder="0.00" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group">
            <label asp-for="Comentarios" class="form-label"></label>
            <textarea asp-for="Comentarios" class="form-control" placeholder="Ingrese comentarios adicionales sobre el anticipo"></textarea>
            <span asp-validation-for="Comentarios" class="text-danger"></span>
        </div>

    <!-- 📂 Campo para subir documento -->
    <div class="mb-3">
        <label for="Documentos" class="form-label">Subir documentos</label>
        <input type="file" name="Documentos" class="form-control" multiple
               accept=".pdf,.doc,.docx,.jpg,.png" />
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Details" asp-controller="Contratos" asp-route-id="@ViewBag.ContratoId" class="btn btn-secondary">Cancelar</a>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        // Cerrar menú lateral si está abierto al cargar esta página
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            if (sidebar && sidebar.classList.contains('active')) {
                sidebar.classList.remove('active');
            }

            // Establecer fecha actual como valor por defecto
            const fechaInput = document.getElementById('FechaSolicitud');
            if (fechaInput && !fechaInput.value) {
                const today = new Date().toISOString().split('T')[0];
                fechaInput.value = today;
            }
        });
    </script>
}